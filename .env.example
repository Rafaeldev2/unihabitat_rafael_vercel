# Supabase (obligatorio)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Catastro / mapas / IA (opcional)
GEOAPIFY_API_KEY=
NEXT_PUBLIC_GEOAPIFY_KEY=
ASSET_UPSERT_AFTER_CATASTRO_ENRICH=false
ANTHROPIC_API_KEY=

# Resend (envío de emails)
# Crear API key en https://resend.com/api-keys con el dominio "unihabitat.net" verificado.
RESEND_API_KEY=
# Remitente de los correos (debe estar en un dominio verificado en Resend).
EMAIL_FROM=Unihabitat <info@unihabitat.net>
# Destinatario interno (formularios de contacto, solicitud de información y ofertas sin vendedor asignado).
EMAIL_SUPPORT=info@unihabitat.net
# En desarrollo, poner "true" para registrar los envíos en consola sin enviarlos.
EMAIL_DRY_RUN=false
# URL base pública (emails, redirects). En Vercel debe ser https://www.tu-dominio.com
NEXT_PUBLIC_APP_URL=
# Opcional: origen canónico solo servidor (no se bakea en build). Si NEXT_PUBLIC_APP_URL
# quedó como http://localhost en un deploy, usar aquí la URL de producción para links de Auth/emails.
APP_ORIGIN=
